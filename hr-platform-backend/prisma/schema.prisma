generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  role                Role
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  employee  Employee?
  auditLogs AuditLog[]

  @@index([email])
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  employees Employee[]
}

model Employee {
  id           String   @id @default(uuid())
  userId       String   @unique
  departmentId String
  fullName     String
  jobTitle     String
  hireDate     DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  department Department  @relation(fields: [departmentId], references: [id])
  salaries   Salary[]
  leaves     LeaveRequest[]
  attendance Attendance[]
  documents  Document[]

  @@index([departmentId])
  @@index([fullName])
}

model Salary {
  id            String   @id @default(uuid())
  employeeId    String
  amount        Decimal  @db.Decimal(12, 2)
  effectiveDate DateTime
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model LeaveRequest {
  id         String      @id @default(uuid())
  employeeId String
  startDate  DateTime
  endDate    DateTime
  status     LeaveStatus @default(PENDING)
  reason     String?
  createdAt  DateTime    @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
}

model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  workDate   DateTime  @db.Date
  checkIn    DateTime?
  checkOut   DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, workDate])
  @@index([employeeId])
}

model Document {
  id         String   @id @default(uuid())
  employeeId String
  filePath   String
  fileName   String
  uploadedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}
